# Copy to .env.local for local development or .env for Docker Compose.
# This template intentionally fails launch checks until real values are supplied.
BOT_TOKEN=replace_with_botfather_token
BOT_USERNAME=replace_me_bot
NEXT_PUBLIC_BOT_USERNAME=replace_me_bot
DATABASE_URL=postgres://colony:replace_with_database_password@localhost:5432/colony
# Docker Compose uses POSTGRES_PASSWORD to create DATABASE_URL inside the app.
# Generate random hex for this value so no URL encoding is needed.
POSTGRES_PASSWORD=replace_with_random_hex_password
APP_URL=https://your-domain.example
ALLOW_DEV_AUTH=false
TELEGRAM_WEBHOOK_SECRET=replace_with_long_random_string

# Generate each secret separately with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Webhook secret: 32–256 characters, A-Z a-z 0-9 _ - only.
CRON_SECRET=replace_with_long_random_secret
ADMIN_TELEGRAM_IDS=replace_with_your_telegram_user_id
SUPPORT_URL=

# v1.0 beta access / operations are controlled from system_settings in PostgreSQL.
# Keep false in production; dev auth bypasses Telegram signature validation.
# Set ALLOW_DEV_AUTH=true only for local npm run dev without Telegram.
# SUPPORT_URL is optional, e.g. an HTTPS support chat. Empty uses in-app feedback.
